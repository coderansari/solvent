# RPC endpoint for Ethereum Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer / operator private key (TESTNET ONLY — never commit a real key)
PRIVATE_KEY=your_testnet_private_key_here

# Optional: for `hardhat verify` on Sepolia Etherscan
ETHERSCAN_API_KEY=

# Optional: auditor address (defaults to deployer if unset)
AUDITOR_ADDRESS=
